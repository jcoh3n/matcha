# Database Configuration
DATABASE_URL=postgresql://matcha_user:matcha_password@localhost:5432/matcha_db

# JWT Configuration (REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — allowed frontend origin
CORS_ORIGIN=http://localhost:5173

# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Configuration (for migration script)
POSTGRES_USER=matcha_user
POSTGRES_PASSWORD=matcha_password
POSTGRES_DB=matcha_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DB Configuration (for application)
DB_USER=matcha_user
DB_PASSWORD=matcha_password
DB_NAME=matcha_db
DB_HOST=localhost
DB_PORT=5432

# Email Configuration
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_email@ethereal.email
EMAIL_PASS=your_password
EMAIL_FROM=noreply@matcha.com
FRONTEND_URL=http://localhost:5173
